{
  "name": "monitoring-automation",
  "version": "1.0.0",
  "description": "Solar farm monitoring automation with daily email reports",
  "main": "dist/scheduler/orchestrator.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "dev": "ts-node src/scheduler/orchestrator.ts",
    "dry-run": "npm run build && node dist/scheduler/orchestrator.js --dry-run",
    "setup-supabase": "ts-node scripts/setup-supabase.ts",
    "scrape:all": "npm run build && node dist/scheduler/scrape-all-farms.js",
    "scrape:hourly": "npm run build && node dist/scheduler/hourly-scraper.js",
    "email:generate": "npm run build && node dist/scheduler/email-generator.js",
    "email:dry-run": "npm run build && node dist/scheduler/email-generator.js --dry-run",
    "data:aggregate": "npm run build && node dist/scheduler/aggregate-data.js",
    "data:cleanup": "npm run build && node dist/scheduler/cleanup-old-data.js"
  },
  "keywords": [
    "solar",
    "monitoring",
    "automation",
    "solarweb"
  ],
  "author": "Evert Lodder",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "dotenv": "^16.3.1",
    "node-cron": "^3.0.2",
    "playwright": "^1.40.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.2"
  }
}
